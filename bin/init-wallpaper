#!/bin/sh
# set desktop background — used by init-input(-desktop) and can be invoked directly
[ -n "$DISPLAY" ] || export DISPLAY=:0
IMG="${WALLPAPER:-$HOME/wallpapers/w.png}"
[ -f "$IMG" ] || IMG=$(find "$HOME/wallpapers" -type f \( -iname '*.png' -o -iname '*.jpg' \) 2>/dev/null | shuf -n1)
[ -f "$IMG" ] && feh --bg-fill --no-fehbg "$IMG" &
