
# add mlp-ultimate-config helper scripts to PATH
export PATH="$HOME/mlp-ultimate-config/bin:$PATH"

# ---------------------------------------------------------------
# daemons: compositor, notifications, clipboard, wallpaper
# ---------------------------------------------------------------
pkill -x picom      2>/dev/null; picom -b --config "$HOME/.config/picom/picom.conf"
pkill -x dunst      2>/dev/null; dunst &
pkill -x clipmenud  2>/dev/null; CM_HISTLENGTH=200 clipmenud &
$HOME/mlp-ultimate-config/bin/init-wallpaper
